# MongoDB connection string (required for contact form and blog)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# GitHub Personal Access Token (optional — increases rate limit from 60 to 5000 req/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXX

# Contact form notifications (all optional). Each channel is used only when
# its variable is set; the MongoDB save above still happens when MONGODB_URI is set.
# Email via Resend: create a key at https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
# Where submissions are delivered (defaults to austinsz@umich.edu)
CONTACT_TO_EMAIL=austinsz@umich.edu
# Sender. onboarding@resend.dev works with no domain setup but can only reach
# the address you signed up to Resend with. After verifying austinshen.com in
# Resend, use something like "Austin Shen Site <contact@austinshen.com>".
CONTACT_FROM_EMAIL="Austin Shen Site <onboarding@resend.dev>"
# Slack or Discord incoming webhook URL, if you also want chat notifications
CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
